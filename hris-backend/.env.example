# Server Configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL Connection Data
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hris_db
DB_PORT=5432

# JWT SECRET (generate with: openssl rand -hex 32)
JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=
# Signs the short-lived login temp token and the password-reset token.
JWT_TEMP_SECRET=
JWT_RESET_SECRET=

# ==========================================
# SMS OTP — login 2FA + forgot-password
# ==========================================
# No gateway is wired up yet. With SMS_PROVIDER=console (the default) codes are
# printed to the server console, and outside production the API also returns the
# code in the response (`devCode`) so the flow is testable. Add a real provider
# in src/utils/sms.js when ready.
SMS_PROVIDER=console
# OTP tuning (optional — these are the defaults)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# ENCRYPTION KEY (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# ==========================================
# AWS S3 — employee document storage
# ==========================================
# Local and live use SEPARATE buckets — set AWS_S3_BUCKET per environment:
#   local dev  -> AWS_S3_BUCKET=hris-local
#   production -> AWS_S3_BUCKET=hris-live
# AWS_S3_KEY_PREFIX is an optional extra folder inside the bucket; leave blank.
AWS_REGION=us-east-1
AWS_S3_BUCKET=hris-local
AWS_S3_KEY_PREFIX=
# How long (seconds) a presigned download link stays valid.
AWS_S3_PRESIGN_EXPIRES=3600
# Access keys for local dev. In production prefer an attached IAM role and leave
# these blank — the SDK falls back to the default credential provider chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==========================================
# Face Recognition — AWS Rekognition (clock-in biometrics)
# ==========================================
# Reference face images live in their OWN bucket (separate from documents), e.g.
#   local dev  -> FACE_S3_BUCKET=hris-face-local
#   production -> FACE_S3_BUCKET=hris-face-live
# Bucket: Block Public Access ON + default encryption ON.
# IAM: s3:{Put,Get,Delete}Object on the bucket, plus rekognition:DetectFaces and
#      rekognition:CompareFaces. Leave FACE_S3_BUCKET blank to disable the feature.
FACE_S3_BUCKET=hris-face-recog-local
FACE_S3_KEY_PREFIX=
# Region for Rekognition calls; falls back to AWS_REGION when blank.
FACE_REKOGNITION_REGION=us-east-1
# Reject an enrollment photo whose single face scores below this confidence.
FACE_MIN_DETECT_CONFIDENCE=90
# Similarity % required to accept a face at clock-in (used by the verify step).
FACE_MATCH_THRESHOLD=90

# --- Face Liveness (optional active anti-spoofing) ---
# Blank = disabled; the PWA then uses the single-photo check.
# Create an IAM role that trusts this IAM identity and allows ONLY
#   rekognition:StartFaceLivenessSession
# and grant this identity: sts:AssumeRole on that role ARN, plus
#   rekognition:CreateFaceLivenessSession, rekognition:GetFaceLivenessSessionResults
FACE_LIVENESS_ROLE_ARN=arn:aws:iam::344838027945:role/HrisFaceLivenessClient
# Liveness confidence % required to pass.
FACE_LIVENESS_THRESHOLD=70
# TTL (seconds, min 900) of the browser credentials vended per session.
FACE_LIVENESS_CRED_TTL=900

# --- Attendance Kiosk (1:N face identification) ---
# Rekognition Face Collection every enrolled face is indexed into so a shared
# kiosk can identify a walk-up. Blank = kiosk disabled. Grant this identity:
#   rekognition:CreateCollection, IndexFaces, SearchFacesByImage, DeleteFaces
# The kiosk also requires FACE_LIVENESS_ROLE_ARN (it always runs a liveness check).
FACE_REKOGNITION_COLLECTION_ID=hris-face-recog-local

# ==========================================
# Scheduler / worker process (npm run worker)
# ==========================================
# Set to "false" to disable all scheduled jobs on this instance.
SCHEDULER_ENABLED=true
# IANA timezone the cron expressions are evaluated in.
SCHEDULER_TIMEZONE=Asia/Manila

# Auto clock-out job — closes attendance rows with no time-out.
AUTO_CLOCK_OUT_CRON=0 2 * * *
# Hours credited to a forgotten punch.
STANDARD_WORKDAY_HOURS=9
# Never auto-close a punch younger than this many hours (night-shift safety window).
AUTO_CLOCK_OUT_MIN_OPEN_HOURS=16
