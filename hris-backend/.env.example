# Server Configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:5175

# PostgreSQL Connection Data
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hris_db
DB_PORT=5432

# JWT SECRET (generate with: openssl rand -hex 32)
JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=
# Signs the short-lived login temp token and the password-reset token.
JWT_TEMP_SECRET=
JWT_RESET_SECRET=

# ==========================================
# SMS OTP — login 2FA + forgot-password
# ==========================================
# No gateway is wired up yet. With SMS_PROVIDER=console (the default) codes are
# printed to the server console, and outside production the API also returns the
# code in the response (`devCode`) so the flow is testable. Add a real provider
# in src/utils/sms.js when ready.
SMS_PROVIDER=console
# OTP tuning (optional — these are the defaults)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# ENCRYPTION KEY (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# ==========================================
# AWS S3 — employee document storage
# ==========================================
# Local and live use SEPARATE buckets — set AWS_S3_BUCKET per environment:
#   local dev  -> AWS_S3_BUCKET=hris-local
#   production -> AWS_S3_BUCKET=hris-live
# AWS_S3_KEY_PREFIX is an optional extra folder inside the bucket; leave blank.
AWS_REGION=us-east-1
AWS_S3_BUCKET=hris-local
AWS_S3_KEY_PREFIX=
# How long (seconds) a presigned download link stays valid.
AWS_S3_PRESIGN_EXPIRES=3600
# Access keys for local dev. In production prefer an attached IAM role and leave
# these blank — the SDK falls back to the default credential provider chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==========================================
# Scheduler / worker process (npm run worker)
# ==========================================
# Set to "false" to disable all scheduled jobs on this instance.
SCHEDULER_ENABLED=true
# IANA timezone the cron expressions are evaluated in.
SCHEDULER_TIMEZONE=Asia/Manila

# Auto clock-out job — closes attendance rows with no time-out.
AUTO_CLOCK_OUT_CRON=0 2 * * *
# Hours credited to a forgotten punch.
STANDARD_WORKDAY_HOURS=9
# Never auto-close a punch younger than this many hours (night-shift safety window).
AUTO_CLOCK_OUT_MIN_OPEN_HOURS=16
