# Server Configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:5175

# PostgreSQL Connection Data
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hris_db
DB_PORT=5432

# JWT SECRET (generate with: openssl rand -hex 32)
JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=

# ENCRYPTION KEY (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# ==========================================
# Scheduler / worker process (npm run worker)
# ==========================================
# Set to "false" to disable all scheduled jobs on this instance.
SCHEDULER_ENABLED=true
# IANA timezone the cron expressions are evaluated in.
SCHEDULER_TIMEZONE=Asia/Manila

# Auto clock-out job — closes attendance rows with no time-out.
AUTO_CLOCK_OUT_CRON=0 2 * * *
# Hours credited to a forgotten punch.
STANDARD_WORKDAY_HOURS=9
# Never auto-close a punch younger than this many hours (night-shift safety window).
AUTO_CLOCK_OUT_MIN_OPEN_HOURS=16
